{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Spring Boot Project",
            "type": "shell",
            "command": "cmd.exe /d /c .\\mvnw.cmd spring-boot:run",
            "options": {
                "env": {
                    "MAVEN_USER_HOME": "${workspaceFolder}\\.m2"
                }
            },
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Run Unit Tests",
            "type": "shell",
            "command": "cmd.exe /d /c .\\mvnw.cmd test",
            "options": {
                "env": {
                    "MAVEN_USER_HOME": "${workspaceFolder}\\.m2"
                }
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Clean and Build",
            "type": "shell",
            "command": "cmd.exe /d /c .\\mvnw.cmd clean install -DskipTests",
            "options": {
                "env": {
                    "MAVEN_USER_HOME": "${workspaceFolder}\\.m2"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}