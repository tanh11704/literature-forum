{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Spring Boot Project",
            "type": "shell",
            "command": ".\\mvnw spring-boot:run",
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Run Unit Tests",
            "type": "shell",
            "command": ".\\mvnw test",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Clean and Build",
            "type": "shell",
            "command": ".\\mvnw clean install -DskipTests",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}